# MCP Hub — environment (arch §65)
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way:
# never commit real credentials (arch §21, §31).
#
#   cp .env.example .env
#
# Everything the hub itself reads is prefixed `MCP_HUB_`; the names map
# one-to-one onto the fields of `app/config/settings.py`, so that file is the
# authoritative list. Anything unset falls back to the default shown here.
#
# Integration credentials are a separate concern and live at the bottom.


# ---------------------------------------------------------------- environment

# development | staging | production | test
# `staging` and `production` refuse to start on development defaults: they
# require an auth secret, PostgreSQL, Redis, and authentication switched on.
MCP_HUB_ENV=development

MCP_HUB_LOG_LEVEL=INFO
# JSON log lines. Unset means "on unless development".
# MCP_HUB_LOG_JSON=true


# -------------------------------------------------------------------- network

# 127.0.0.1 for local work. Compose sets 0.0.0.0 so the container is reachable.
MCP_HUB_HOST=127.0.0.1
MCP_HUB_PORT=8000

# The single MCP endpoint (arch §10). Clients connect here and nowhere else.
MCP_HUB_MCP_PATH=/mcp

# Externally reachable base URL. Required for OAuth metadata behind a proxy,
# because the hub must advertise the URL the client can actually reach.
# MCP_HUB_PUBLIC_URL=https://mcp.example.com

# Browser origins allowed to call the REST API. Empty means none.
# MCP_HUB_CORS_ORIGINS=["https://console.example.com"]


# -------------------------------------------------------------------- storage

# SQLite is the zero-setup local default. PostgreSQL is required outside
# development (arch §27) — note the async driver in both spellings.
MCP_HUB_DATABASE_URL=sqlite+aiosqlite:///./runtime/mcp_hub.db
# MCP_HUB_DATABASE_URL=postgresql+asyncpg://mcp_hub:change-me@postgres:5432/mcp_hub

# Redis backs distributed locks, rate limits and caches (arch §28, §30).
# Without it those become per-process, which is correct only for a single
# worker — so it is required outside development.
# MCP_HUB_REDIS_URL=redis://redis:6379/0

# Log every SQL statement. Debugging only; noisy.
MCP_HUB_DATABASE_ECHO=false


# ------------------------------------------------------------------- security

# HMAC key for hub-issued tokens and sealed request state. Required outside
# development. Generate one:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
MCP_HUB_AUTH_SECRET=

# Refuse unauthenticated MCP and API traffic. Never disable outside a laptop —
# it cannot be disabled in staging or production at all.
MCP_HUB_AUTH_REQUIRED=true

# Static admin tokens, for bootstrapping the first real credential only.
# Prefer `mcp-hub token issue`. JSON list, because it is a tuple field.
# MCP_HUB_ADMIN_TOKENS=["paste-a-long-random-string"]

MCP_HUB_TOKEN_TTL_SECONDS=3600

# Secret providers, consulted in order (arch §21):
#   environment         — read-only, from this file and the process environment
#   encrypted_database  — Fernet-sealed rows, supports per-user credentials
#   vault               — an external secret manager
# JSON list. `environment` alone cannot hold per-user credentials, so a
# deployment where users bring their own tokens needs one of the others.
MCP_HUB_SECRET_PROVIDERS=["environment"]

# Fernet key for `encrypted_database`. Required when that provider is enabled;
# losing it makes every stored secret unrecoverable. Generate one:
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# MCP_HUB_SECRET_ENCRYPTION_KEY=

# External secret manager, for the `vault` provider.
# MCP_HUB_VAULT_URL=https://vault.example.com
# MCP_HUB_VAULT_TOKEN=


# -------------------------------------------------------------------- gateway

# How tools are exposed when there are many (arch §13):
#   all | grouped | search_first | dynamic
# Unset means the catalog decides.
# MCP_HUB_TOOL_EXPOSURE_MODE=all

MCP_HUB_UPSTREAM_CONNECT_TIMEOUT_SECONDS=30
MCP_HUB_UPSTREAM_REQUEST_TIMEOUT_SECONDS=60
MCP_HUB_UPSTREAM_SESSION_IDLE_SECONDS=300
MCP_HUB_UPSTREAM_MAX_SESSIONS=64
MCP_HUB_TOOL_CACHE_TTL_SECONDS=300
MCP_HUB_DISCOVERY_CONCURRENCY=8


# ------------------------------------------------------------------ lifecycle

# Update integrations concurrently (arch §30). Sequential by default: it is
# slower and much easier to reason about when something fails.
MCP_HUB_ALLOW_PARALLEL_UPDATES=false

# Restore the previous version automatically when an update fails (arch §59).
MCP_HUB_ROLLBACK_ON_FAILURE=true

MCP_HUB_LOCK_TIMEOUT_SECONDS=900
MCP_HUB_BACKUP_RETENTION=10
MCP_HUB_VERSION_RETENTION=5

# Refuse artifacts without verifiable provenance (arch §55). Off by default
# because most community servers are not signed yet; on is the safer posture.
MCP_HUB_REQUIRE_SIGNED_ARTIFACTS=false

# Permit Docker images referenced by tag rather than digest. Forced off in
# production, where a mutable tag means an unreviewed image can arrive.
# MCP_HUB_ALLOW_MUTABLE_IMAGE_TAGS=true


# ------------------------------------------------------------------- registry

MCP_HUB_REGISTRY_URL=https://registry.modelcontextprotocol.io
MCP_HUB_REGISTRY_TIMEOUT_SECONDS=15
MCP_HUB_REGISTRY_CACHE_TTL_SECONDS=900


# ---------------------------------------------------------------------- paths

# Absolute or relative to the process working directory. The container image
# sets these to /app/config and /app/runtime.
# MCP_HUB_CONFIG_DIR=./config
# MCP_HUB_RUNTIME_DIR=./runtime


# -------------------------------------------------------------- observability

# Serve Prometheus metrics at /metrics (arch §44).
MCP_HUB_METRICS_ENABLED=true


# ------------------------------------------------ integration credentials
#
# These belong to the upstream MCP servers, not to the hub, so they use the
# names those servers document. The `environment` provider also accepts a
# namespaced spelling — MCP_HUB_SECRET_BRAVE_API_KEY — if you would rather keep
# every hub variable under one prefix.
#
# Credentials set here are DEPLOYMENT-WIDE: every caller shares them. For the
# integrations marked per-user below, that is a deliberate downgrade — the hub
# will use each caller's own token when a provider that supports per-user
# storage is configured, and only falls back to nothing (never to someone
# else's token) when it is not (arch §20).
#
# Store per-user credentials instead with:
#
#   mcp-hub secrets set ATLASSIAN_TOKEN --stdin --user alice@example.com
#
# which reads the value from stdin so it never lands in shell history.

# Brave Search — a metered account key, shared by the whole deployment.
# https://brave.com/search/api/
BRAVE_API_KEY=

# GitHub — per-user. A classic or fine-grained PAT.
# https://github.com/settings/tokens
# GITHUB_TOKEN=

# Jira / Confluence — per-user. An Atlassian API token or OAuth access token.
# https://id.atlassian.com/manage-profile/security/api-tokens
# ATLASSIAN_TOKEN=

# Figma — per-user. A personal access token with `files:read`.
# https://www.figma.com/developers/api#access-tokens
# FIGMA_TOKEN=

# Notion — per-user. An internal integration token.
# https://www.notion.so/my-integrations
# NOTION_TOKEN=
