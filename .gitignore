# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets — never commit real credentials (arch §21, §31, §65).
.env
.env.*
!.env.example

# Mutable state: installed integration versions, backups, caches, logs and the
# local SQLite database. All of it is reproducible from config/ (arch §9).
runtime/

# Resolved state. Generated by the hub from integrations.yaml; committing it
# is a deliberate choice (it pins exactly what runs) — uncomment to opt in.
config/integrations.lock.yaml

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
